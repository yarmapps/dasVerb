def archive_metadata_history(platform)
  date_str = Time.now.strftime("%d.%m.%Y")
  meta_src_dir = File.expand_path("metadata/#{platform}", __dir__)
  shots_src_dir = File.expand_path("screenshots/#{platform}", __dir__)
  base_history_dir = File.expand_path("metadata_history/#{platform}", __dir__)
  dest_dir = File.join(base_history_dir, date_str)

  unless File.exist?(meta_src_dir)
    UI.error("Could not find metadata at #{meta_src_dir}")
    return
  end

  existing_snapshots = Dir.glob(File.join(base_history_dir, "*")).select { |f| File.directory?(f) }
  latest_snapshot = existing_snapshots.sort_by { |f| File.mtime(f) }.last

  if latest_snapshot
    has_changes = false

    Dir.glob(File.join(meta_src_dir, "**", "*")).each do |src_file|
      next if File.directory?(src_file)

      rel_path = src_file.sub("#{meta_src_dir}/", "")
      next if rel_path.end_with?("release_notes.txt") || rel_path.include?("changelogs/")

      snapshot_file = File.join(latest_snapshot, rel_path)
      snapshot_file_nested = File.join(latest_snapshot, "metadata", rel_path)

      unless (File.exist?(snapshot_file) && File.read(src_file) == File.read(snapshot_file)) ||
             (File.exist?(snapshot_file_nested) && File.read(src_file) == File.read(snapshot_file_nested))
        has_changes = true
        break
      end
    end

    if !has_changes && File.exist?(shots_src_dir)
      Dir.glob(File.join(shots_src_dir, "**", "*")).each do |src_file|
        next if File.directory?(src_file)

        rel_path = src_file.sub("#{shots_src_dir}/", "")
        snapshot_file = File.join(latest_snapshot, "screenshots", rel_path)

        unless File.exist?(snapshot_file) && File.read(src_file) == File.read(snapshot_file)
          has_changes = true
          break
        end
      end
    end

    unless has_changes
      UI.message("Skipped archiving #{platform} history (no changes to core metadata or screenshots detected).")
      return
    end
  end

  meta_dest = File.join(dest_dir, "metadata")
  FileUtils.mkdir_p(meta_dest)
  FileUtils.cp_r("#{meta_src_dir}/.", meta_dest)

  if File.exist?(shots_src_dir)
    shots_dest = File.join(dest_dir, "screenshots")
    FileUtils.mkdir_p(shots_dest)
    FileUtils.cp_r("#{shots_src_dir}/.", shots_dest)
  end

  UI.success("Archived #{platform} core metadata & screenshots to ./fastlane/metadata_history/#{platform}/#{date_str} 📦")
end

default_platform(:ios)

platform :ios do
  before_all do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || "3P98PH5M24"
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || "4222448c-08ac-4305-b6b8-471b102c1dbf"
    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"] || "./credentials/ios/AuthKey_#{key_id}.p8"

    if issuer_id && !issuer_id.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_filepath
      )
    end
  end

  desc "Download live App Store metadata directly into fastlane/metadata/ios"
  lane :download_metadata do
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    unless app
      UI.user_error!("Could not find app com.yarm.apps.dasverb on App Store Connect")
    end

    # 1. Fetch Version Localizations (description, keywords, release_notes, promo text, URLs)
    versions = app.get_app_store_versions
    versions.each do |v|
      locs = v.get_app_store_version_localizations rescue []
      locs.each do |loc|
        locale = loc.locale
        dir = File.join("./metadata/ios", locale)
        FileUtils.mkdir_p(dir)

        desc_text = loc.description rescue nil
        keywords_text = loc.keywords rescue nil
        notes_text = loc.whats_new rescue nil
        promo_text = loc.promotional_text rescue nil
        support_text = loc.support_url rescue nil
        marketing_text = loc.marketing_url rescue nil

        File.write(File.join(dir, "description.txt"), desc_text.to_s) if desc_text && !desc_text.to_s.empty?
        File.write(File.join(dir, "keywords.txt"), keywords_text.to_s) if keywords_text && !keywords_text.to_s.empty?
        File.write(File.join(dir, "release_notes.txt"), notes_text.to_s) if notes_text && !notes_text.to_s.empty?
        File.write(File.join(dir, "promotional_text.txt"), promo_text.to_s) if promo_text && !promo_text.to_s.empty?
        File.write(File.join(dir, "support_url.txt"), support_text.to_s) if support_text && !support_text.to_s.empty?
        File.write(File.join(dir, "marketing_url.txt"), marketing_text.to_s) if marketing_text && !marketing_text.to_s.empty?
      end
    end

    # 2. Fetch App Info Localizations (Name, Subtitle, Privacy URL)
    begin
      app_infos = Spaceship::ConnectAPI.get_app_infos(app_id: app.id)
      if app_infos && app_infos.first
        info_locs = app_infos.first.get_app_info_localizations rescue []
        info_locs.each do |info_loc|
          locale = info_loc.locale
          dir = File.join("./metadata/ios", locale)
          FileUtils.mkdir_p(dir)

          name_text = info_loc.name rescue nil
          subtitle_text = info_loc.subtitle rescue nil
          privacy_text = info_loc.privacy_policy_url rescue nil

          File.write(File.join(dir, "name.txt"), name_text.to_s) if name_text && !name_text.to_s.empty?
          File.write(File.join(dir, "subtitle.txt"), subtitle_text.to_s) if subtitle_text && !subtitle_text.to_s.empty?
          File.write(File.join(dir, "privacy_url.txt"), privacy_text.to_s) if privacy_text && !privacy_text.to_s.empty?
        end
      end
    rescue => e
      UI.error("App Info fetch error: #{e.message}")
    end

    UI.success("Successfully downloaded all live App Store metadata into ./fastlane/metadata/ios 🎉")
  end

  desc "Delete obsolete localizations from App Store Connect for current editable version"
  lane :delete_obsolete_localizations do
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    unless app
      UI.user_error!("Could not find app com.yarm.apps.dasverb on App Store Connect")
    end

    allowed_locales = [
      'en-US', 'de-DE', 'ru', 'uk', 'es-ES', 'fr-FR', 'it', 'pl', 'pt-BR', 'tr', 'ar-SA'
    ]

    edit_version = app.get_edit_app_store_version
    unless edit_version
      UI.important("No edit_version found directly, searching all versions...")
      versions = app.get_app_store_versions
      edit_version = versions.find { |v| ["PREPARE_FOR_SUBMISSION", "DEVELOPER_REJECTED", "REJECTED", "WAITING_FOR_REVIEW"].include?(v.app_store_state) } || versions.first
    end

    UI.message("Working on Version: #{edit_version.version_string} (#{edit_version.app_store_state}) [ID: #{edit_version.id}]")

    version_locs = edit_version.get_app_store_version_localizations rescue []
    UI.message("Found #{version_locs.length} version localizations on App Store Connect.")

    deleted_count = 0
    version_locs.each do |loc|
      if allowed_locales.include?(loc.locale)
        UI.message("  ✅ Keeping version locale: [#{loc.locale}]")
      else
        UI.important("  🗑 Deleting obsolete version locale: [#{loc.locale}] (ID: #{loc.id})...")
        begin
          if loc.respond_to?(:delete!)
            loc.delete!
          else
            Spaceship::ConnectAPI.delete_app_store_version_localization(app_store_version_localization_id: loc.id)
          end
          deleted_count += 1
          UI.success("  Successfully deleted [#{loc.locale}] 🎉")
        rescue => e
          UI.error("  Failed to delete [#{loc.locale}]: #{e.message}")
        end
      end
    end

    # App Info localizations (Name/Subtitle)
    begin
      app_infos = Spaceship::ConnectAPI.get_app_infos(app_id: app.id)
      if app_infos && app_infos.first
        info_locs = app_infos.first.get_app_info_localizations rescue []
        UI.message("\nFound #{info_locs.length} App Info localizations.")
        info_locs.each do |info_loc|
          if allowed_locales.include?(info_loc.locale)
            UI.message("  ✅ Keeping App Info locale: [#{info_loc.locale}]")
          else
            UI.important("  🗑 Deleting obsolete App Info locale: [#{info_loc.locale}] (ID: #{info_loc.id})...")
            begin
              if info_loc.respond_to?(:delete!)
                info_loc.delete!
              else
                Spaceship::ConnectAPI.delete_app_info_localization(app_info_localization_id: info_loc.id)
              end
              UI.success("  Successfully deleted App Info locale [#{info_loc.locale}] 🎉")
            rescue => e
              UI.important("  Could not delete App Info locale [#{info_loc.locale}] (might be primary or locked): #{e.message}")
            end
          end
        end
      end
    rescue => e
      UI.error("App Info check error: #{e.message}")
    end

    UI.success("\n🎉 Finished deleting #{deleted_count} obsolete localizations from App Store Connect!")
  end


  desc "Download live App Store screenshots into fastlane/screenshots/ios"
  lane :download_screenshots do
    require 'open-uri'
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    unless app
      UI.user_error!("Could not find app com.yarm.apps.dasverb on App Store Connect")
    end

    version = app.get_edit_app_store_version || app.get_live_app_store_version
    unless version
      UI.user_error!("Could not find active version on App Store Connect")
    end

    UI.message("Fetching screenshots for #{app.name} (Version #{version.version_string})...")

    localizations = version.get_app_store_version_localizations
    localizations.each do |loc|
      locale = loc.locale
      screenshot_sets = loc.get_app_screenshot_sets rescue []

      screenshot_sets.each do |set|
        display_type = set.screenshot_display_type
        screenshots = set.app_screenshots rescue []

        screenshots.each_with_index do |shot, index|
          image_url = shot.image_asset_url rescue nil
          next unless image_url

          dir = File.join("./screenshots/ios", locale)
          FileUtils.mkdir_p(dir)

          file_name = "#{display_type}_#{index + 1}.png"
          file_path = File.join(dir, file_name)

          begin
            URI.open(image_url) do |image|
              File.open(file_path, 'wb') do |file|
                file.write(image.read)
              end
            end
            UI.success("Downloaded screenshot for [#{locale}]: #{file_name}")
          rescue => e
            UI.error("Failed downloading screenshot #{file_name}: #{e.message}")
          end
        end
      end
    end

    UI.success("Successfully downloaded all live App Store screenshots into ./fastlane/screenshots/ios 🎉")
  end

  desc "Upload updated text metadata from fastlane/metadata/ios to App Store Connect"
  lane :sync_metadata do
    archive_metadata_history("ios")

    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    unless app
      UI.user_error!("Could not find app com.yarm.apps.dasverb on App Store Connect")
    end

    meta_base = File.expand_path("metadata/ios", __dir__)
    allowed_locales = Dir.glob(File.join(meta_base, "*")).select { |f| File.directory?(f) }.map { |f| File.basename(f) }

    UI.message("📱 Found #{allowed_locales.length} local metadata directories: #{allowed_locales.join(', ')}")

    # 1. Update App Info Localizations (Name, Subtitle, Privacy URL)
    begin
      app_infos = Spaceship::ConnectAPI.get_app_infos(app_id: app.id)
      if app_infos && app_infos.first
        info = app_infos.first
        info_locs = info.get_app_info_localizations rescue []
        UI.message("\n🏷️  Syncing App Info Localizations (Name & Subtitle)...")

        allowed_locales.each do |locale|
          dir = File.join(meta_base, locale)
          name_file = File.join(dir, "name.txt")
          sub_file = File.join(dir, "subtitle.txt")
          priv_file = File.join(dir, "privacy_url.txt")

          name_text = File.exist?(name_file) ? File.read(name_file).strip : nil
          sub_text = File.exist?(sub_file) ? File.read(sub_file).strip : nil
          priv_text = File.exist?(priv_file) ? File.read(priv_file).strip : nil

          existing_info_loc = info_locs.find { |l| l.locale == locale }

          attributes = {}
          attributes[:name] = name_text if name_text && !name_text.empty?
          attributes[:subtitle] = sub_text if sub_text && !sub_text.empty?
          attributes[:privacyPolicyUrl] = priv_text if priv_text && !priv_text.empty?

          if existing_info_loc
            UI.message("  Updating App Info [#{locale}]: Name=\"#{name_text}\", Subtitle=\"#{sub_text}\"")
            begin
              existing_info_loc.update(attributes: attributes)
              UI.success("    ✅ Updated App Info [#{locale}]")
            rescue => e
              UI.error("    ❌ Error updating App Info [#{locale}]: #{e.message}")
            end
          else
            UI.message("  Creating App Info [#{locale}]: Name=\"#{name_text}\", Subtitle=\"#{sub_text}\"")
            begin
              Spaceship::ConnectAPI.create_app_info_localization(
                app_info_id: info.id,
                attributes: attributes.merge(locale: locale)
              )
              UI.success("    ✅ Created App Info [#{locale}]")
            rescue => e
              UI.error("    ❌ Error creating App Info [#{locale}]: #{e.message}")
            end
          end
        end
      end
    rescue => e
      UI.error("App Info sync error: #{e.message}")
    end

    # 2. Update Version Localizations (Keywords, Description, Promo, Release Notes, URLs)
    UI.message("\n📝 Syncing App Store Version Localizations (Keywords, Description, etc.)...")
    versions = app.get_app_store_versions
    edit_version = versions.find { |v| ["PREPARE_FOR_SUBMISSION", "DEVELOPER_REJECTED", "REJECTED"].include?(v.app_store_state) }

    if edit_version.nil?
      live_version = versions.find { |v| v.app_store_state == "READY_FOR_SALE" }
      UI.important("⚠️  No editable version in 'Prepare for Submission' state found.")
      if live_version
        UI.important("Found Live Version: #{live_version.version_string} (#{live_version.app_store_state}).")
        UI.important("Note: Apple App Store Connect ONLY permits updating 'promotional_text' on live versions. Keywords and Description require creating a new version draft in App Store Connect!")
      end
      target_version = live_version || versions.first
    else
      target_version = edit_version
      UI.success("🎯 Found editable version: #{target_version.version_string} (#{target_version.app_store_state}) [ID: #{target_version.id}]")
    end

    if target_version
      version_locs = target_version.get_app_store_version_localizations rescue []

      allowed_locales.each do |locale|
        dir = File.join(meta_base, locale)
        kw_file = File.join(dir, "keywords.txt")
        desc_file = File.join(dir, "description.txt")
        promo_file = File.join(dir, "promotional_text.txt")
        notes_file = File.join(dir, "release_notes.txt")
        support_file = File.join(dir, "support_url.txt")
        mkt_file = File.join(dir, "marketing_url.txt")

        kw_text = File.exist?(kw_file) ? File.read(kw_file).strip : nil
        desc_text = File.exist?(desc_file) ? File.read(desc_file).strip : nil
        promo_text = File.exist?(promo_file) ? File.read(promo_file).strip : nil
        notes_text = File.exist?(notes_file) ? File.read(notes_file).strip : nil
        support_text = File.exist?(support_file) ? File.read(support_file).strip : nil
        mkt_text = File.exist?(mkt_file) ? File.read(mkt_file).strip : nil

        existing_ver_loc = version_locs.find { |l| l.locale == locale }

        attributes = {}
        attributes[:keywords] = kw_text if kw_text && !kw_text.empty?
        attributes[:description] = desc_text if desc_text && !desc_text.empty?
        attributes[:promotionalText] = promo_text if promo_text && !promo_text.empty?
        attributes[:whatsNew] = notes_text if notes_text && !notes_text.empty?
        attributes[:supportUrl] = support_text if support_text && !support_text.empty?
        attributes[:marketingUrl] = mkt_text if mkt_text && !mkt_text.empty?

        kw_bytes = kw_text ? kw_text.bytesize : 0

        if existing_ver_loc
          UI.message("  Updating Version Localization [#{locale}] (Keywords: #{kw_bytes} bytes)...")
          begin
            existing_ver_loc.update(attributes: attributes)
            UI.success("    ✅ Updated Version Localization [#{locale}] with #{kw_bytes}b keywords!")
          rescue => e
            UI.error("    ❌ Error updating Version Localization [#{locale}]: #{e.message}")
          end
        else
          UI.message("  Creating Version Localization [#{locale}] (Keywords: #{kw_bytes} bytes)...")
          begin
            Spaceship::ConnectAPI.create_app_store_version_localization(
              app_store_version_id: target_version.id,
              attributes: attributes.merge(locale: locale)
            )
            UI.success("    ✅ Created Version Localization [#{locale}] with #{kw_bytes}b keywords!")
          rescue => e
            UI.error("    ❌ Error creating Version Localization [#{locale}]: #{e.message}")
          end
        end
      end
    end

    UI.success("\n🎉 Metadata synchronization to App Store Connect completed successfully!")
  end

  desc "Test keyword character limit on App Store Connect"
  lane :test_keyword_limit do
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    versions = app.get_app_store_versions
    edit_version = versions.find { |v| ["PREPARE_FOR_SUBMISSION", "DEVELOPER_REJECTED", "REJECTED"].include?(v.app_store_state) } || versions.first

    UI.message("Testing keyword length on Version: #{edit_version.version_string} (#{edit_version.app_store_state})")
    version_locs = edit_version.get_app_store_version_localizations rescue []
    uk_loc = version_locs.find { |l| l.locale == "uk" }

    if uk_loc
      # Test 1: 95 characters (approx 170 bytes in Cyrillic)
      test_kw = "неправильні,слова,вчити,тренажер,тест,мова,граматика,відмінювання,німецька,дієслова"
      UI.message("Attempting to send #{test_kw.length} characters (#{test_kw.bytesize} bytes): \"#{test_kw}\"")
      begin
        uk_loc.update(attributes: { keywords: test_kw })
        UI.success("🎉 SUCCESS! App Store Connect accepted #{test_kw.length} characters (#{test_kw.bytesize} bytes)!")
      rescue => e
        UI.error("❌ REJECTED by Apple API: #{e.message}")
      end
    end
  end

  desc "Upload screenshots from fastlane/screenshots/ios to App Store Connect"
  lane :sync_screenshots do
    archive_metadata_history("ios")
    deliver(
      metadata_path: "./fastlane/metadata/ios",
      screenshots_path: "./fastlane/screenshots/ios",
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Upload production build.ipa and metadata to App Store Connect"
  lane :release_production do |options|
    archive_metadata_history("ios")
    ipa_path = options[:ipa] || "build.ipa"
    deliver(
      metadata_path: "./fastlane/metadata/ios",
      screenshots_path: "./fastlane/screenshots/ios",
      ipa: ipa_path,
      skip_metadata: options[:skip_metadata] || false,
      skip_screenshots: options[:skip_screenshots] || false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
      submit_for_review: false
    )
  end

  desc "Sync localizations for Yearly Subscription (dasverb_premium_year) on App Store Connect"
  lane :sync_yearly_subscription_localizations do
    sub_id = "6824538028"
    token = Spaceship::ConnectAPI.token.text
    require "net/http"
    require "json"

    localizations_data = {
      "ar-SA" => { name: "das Verb: سنة واحدة بريميوم", desc: "بدون إعلانات، جميع الأفعال A1-B2 واختبارات" },
      "cs" => { name: "das Verb: 1 Rok Premium", desc: "Bez reklam, všechna slovesa A1-B2" },
      "da" => { name: "das Verb: 1 År Premium", desc: "Reklamefri, alle verber A1-B2 & quiz" },
      "de-DE" => { name: "das Verb: 1 Jahr Premium", desc: "Werbefrei, alle Verben A1-B2 & Tests" },
      "el" => { name: "das Verb: Premium 1 Έτος", desc: "Χωρίς διαφημίσεις, ρήματα A1-B2" },
      "en-US" => { name: "das Verb: 1 Year Premium", desc: "All verbs A1-B2, prepositions & quizzes" },
      "es-ES" => { name: "das Verb: Premium 1 Año", desc: "Sin anuncios, todos los verbos A1-B2" },
      "es-MX" => { name: "das Verb: Premium 1 Año", desc: "Sin anuncios, todos los verbos A1-B2" },
      "fi" => { name: "das Verb: 1 Vuosi Premium", desc: "Ei mainoksia, kaikki verbit A1-B2 & testit" },
      "fr-CA" => { name: "das Verb: Premium 1 An", desc: "Sans pub, tous les verbes A1-B2 & quiz" },
      "fr-FR" => { name: "das Verb: Premium 1 An", desc: "Sans pub, tous les verbes A1-B2 & quiz" },
      "hi" => { name: "das Verb: 1 वर्ष प्रीमियम", desc: "विज्ञापन मुक्त, सभी क्रियाएं A1-B2 और क्विज़" },
      "hr" => { name: "das Verb: 1 Godina Premium", desc: "Bez reklama, svi glagoli A1-B2" },
      "hu" => { name: "das Verb: 1 Éves Premium", desc: "Reklámmentes, minden ige A1-B2 & tesztek" },
      "id" => { name: "das Verb: Premium 1 Tahun", desc: "Bebas iklan, semua kata kerja A1-B2" },
      "it" => { name: "das Verb: Premium 1 Anno", desc: "No pubblicità, tutti i verbi A1-B2" },
      "nl-NL" => { name: "das Verb: 1 Jaar Premium", desc: "Reclamevrij, alle werkwoorden A1-B2" },
      "no" => { name: "das Verb: 1 År Premium", desc: "Reklamefri, alle verb A1-B2 & quiz" },
      "pl" => { name: "das Verb: Premium 1 Rok", desc: "Bez reklam, wszystkie czasowniki A1-B2" },
      "pt-BR" => { name: "das Verb: Premium 1 Ano", desc: "Sem anúncios, todos os verbos A1-B2" },
      "pt-PT" => { name: "das Verb: Premium 1 Ano", desc: "Sem anúncios, todos os verbos A1-B2" },
      "ro" => { name: "das Verb: Premium 1 An", desc: "Fără reclame, toate verbele A1-B2" },
      "ru" => { name: "das Verb: Годовой Премиум", desc: "Без рекламы, все глаголы A1-B2 и тесты" },
      "sk" => { name: "das Verb: 1 Rok Premium", desc: "Bez reklám, všetky slovesá A1-B2" },
      "sv" => { name: "das Verb: 1 År Premium", desc: "Reklamfritt, alla verb A1-B2 & quiz" },
      "tr" => { name: "das Verb: 1 Yıllık Premium", desc: "Reklamsız, tüm fiiller A1-B2 ve testler" },
      "uk" => { name: "das Verb: Річний Преміум", desc: "Без реклами, всі дієслова A1-B2 та квізи" },
      "vi" => { name: "das Verb: Premium 1 Năm", desc: "Không quảng cáo, toàn bộ động từ A1-B2" }
    }

    # 1. Fetch existing localizations for the subscription
    uri = URI("https://api.appstoreconnect.apple.com/v1/subscriptions/#{sub_id}/subscriptionLocalizations")
    req = Net::HTTP::Get.new(uri)
    req["Authorization"] = "Bearer #{token}"
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
    existing = JSON.parse(res.body)["data"] || []
    existing_map = {}
    existing.each do |loc|
      existing_map[loc["attributes"]["locale"]] = loc
    end

    UI.message("Found #{existing_map.length} existing localizations for subscription #{sub_id}.")

    # 2. Iterate and create or update
    localizations_data.each do |locale, data|
      name = data[:name]
      desc = data[:desc]

      if existing_map.key?(locale)
        loc_id = existing_map[locale]["id"]
        current_name = existing_map[locale]["attributes"]["name"]
        current_desc = existing_map[locale]["attributes"]["description"]

        if current_name == name && current_desc == desc
          UI.success("Locale '#{locale}' already up to date: '#{name}'")
          next
        end

        patch_uri = URI("https://api.appstoreconnect.apple.com/v1/subscriptionLocalizations/#{loc_id}")
        patch_req = Net::HTTP::Patch.new(patch_uri)
        patch_req["Authorization"] = "Bearer #{token}"
        patch_req["Content-Type"] = "application/json"
        patch_body = {
          data: {
            type: "subscriptionLocalizations",
            id: loc_id,
            attributes: {
              name: name,
              description: desc
            }
          }
        }
        patch_req.body = JSON.generate(patch_body)
        patch_res = Net::HTTP.start(patch_uri.hostname, patch_uri.port, use_ssl: true) { |h| h.request(patch_req) }

        if patch_res.code.to_i == 200
          UI.success("Updated locale '#{locale}': '#{name}' 🎉")
        else
          UI.error("Failed to update locale '#{locale}' (#{patch_res.code}): #{patch_res.body}")
        end
      else
        post_uri = URI("https://api.appstoreconnect.apple.com/v1/subscriptionLocalizations")
        post_req = Net::HTTP::Post.new(post_uri)
        post_req["Authorization"] = "Bearer #{token}"
        post_req["Content-Type"] = "application/json"
        post_body = {
          data: {
            type: "subscriptionLocalizations",
            attributes: {
              name: name,
              description: desc,
              locale: locale
            },
            relationships: {
              subscription: {
                data: {
                  type: "subscriptions",
                  id: sub_id
                }
              }
            }
          }
        }
        post_req.body = JSON.generate(post_body)
        post_res = Net::HTTP.start(post_uri.hostname, post_uri.port, use_ssl: true) { |h| h.request(post_req) }

        if post_res.code.to_i == 201
          UI.success("Created locale '#{locale}': '#{name}' 🎉")
        else
          UI.error("Failed to create locale '#{locale}' (#{post_res.code}): #{post_res.body}")
        end
      end
    end

    UI.success("All localizations for Yearly Subscription (dasverb_premium_year) synced successfully! 🚀")
  end

  desc "Check existing in-app purchases and subscriptions on App Store Connect"
  lane :check_iap do
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    UI.message("Found App: #{app.name} (ID: #{app.id})")

    token = Spaceship::ConnectAPI.token.text
    require "net/http"
    require "json"

    fetch_api = lambda do |endpoint|
      uri = URI("https://api.appstoreconnect.apple.com/v1/#{endpoint}")
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{token}"
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      JSON.parse(res.body) rescue { "error" => res.body }
    end

    groups = fetch_api.call("apps/#{app.id}/subscriptionGroups")
    UI.message("Subscription groups: #{groups.inspect}")

    subs = fetch_api.call("subscriptionGroups/22354472/subscriptions")
    (subs["data"] || []).each do |s|
      UI.message("Sub: ID=#{s['id']}, name=#{s['attributes']['name']}, productId=#{s['attributes']['productId']}")
    end
  end

  desc "Create subscription group, subscriptions and lifetime IAP on App Store Connect"
  lane :setup_iap do
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    UI.message("Setting up IAP and Subscriptions for: #{app.name} (ID: #{app.id})")
    client = Spaceship::ConnectAPI.client.tunes_request_client
    UI.message("tunes client methods: #{client.methods - Object.methods}")
    UI.message("client hostname: #{client.hostname rescue 'none'}")
    UI.message("client url_builder: #{client.url_builder rescue 'none'}")

    # 1. Lifetime Non-Consumable IAP
    begin
      iaps = Spaceship::ConnectAPI.get_in_app_purchases(filter: { app: app.id }).all_pages rescue []
      lifetime = iaps.find { |i| i.product_id == "premium_lifetime" }
      if lifetime
        UI.success("Lifetime product already exists: #{lifetime.product_id} (ID: #{lifetime.id})")
      else
        body = {
          data: {
            type: "inAppPurchases",
            attributes: {
              name: "Lifetime Premium",
              productId: "premium_lifetime",
              inAppPurchaseType: "NON_CONSUMABLE"
            },
            relationships: {
              app: {
                data: {
                  type: "apps",
                  id: app.id
                }
              }
            }
          }
        }
        res = Spaceship::ConnectAPI.client.tunes_request_client.post("inAppPurchasesV2", body)
        UI.success("Created Lifetime In-App Purchase: premium_lifetime 🎉")
      end
    rescue => e
      UI.error("Error creating Lifetime IAP: #{e.message}")
    end

    # 2. Subscription Group
    group_id = nil
    begin
      groups = Spaceship::ConnectAPI.get_subscription_groups(filter: { app: app.id }).all_pages rescue []
      group = groups.find { |g| g.reference_name == "dasVerb Premium" }
      if group
        group_id = group.id
        UI.success("Subscription Group already exists: #{group.reference_name} (ID: #{group_id})")
      else
        body = {
          data: {
            type: "subscriptionGroups",
            attributes: {
              referenceName: "dasVerb Premium"
            },
            relationships: {
              app: {
                data: {
                  type: "apps",
                  id: app.id
                }
              }
            }
          }
        }
        res = Spaceship::ConnectAPI.client.tunes_request_client.post("subscriptionGroups", body)
        group_id = res.body["data"]["id"]
        UI.success("Created Subscription Group: dasVerb Premium (ID: #{group_id}) 🎉")
      end
    rescue => e
      UI.error("Error creating Subscription Group: #{e.message}")
    end

    # 3. Subscriptions (Monthly & Yearly)
    if group_id
      existing_subs = Spaceship::ConnectAPI.get_subscriptions(filter: { subscription_group: group_id }).all_pages rescue []

      # Monthly
      monthly = existing_subs.find { |s| s.product_id == "premium_monthly" }
      if monthly
        UI.success("Monthly subscription already exists: premium_monthly (ID: #{monthly.id})")
      else
        begin
          body = {
            data: {
              type: "subscriptions",
              attributes: {
                name: "Monthly Premium",
                productId: "premium_monthly",
                subscriptionPeriod: "ONE_MONTH",
                groupLevel: 2
              },
              relationships: {
                group: {
                  data: {
                    type: "subscriptionGroups",
                    id: group_id
                  }
                }
              }
            }
          }
          res = Spaceship::ConnectAPI.client.tunes_request_client.post("subscriptions", body)
          UI.success("Created Monthly Subscription: premium_monthly 🎉")
        rescue => e
          UI.error("Error creating Monthly Subscription: #{e.message}")
        end
      end

      # Yearly
      yearly = existing_subs.find { |s| s.product_id == "premium_yearly" }
      if yearly
        UI.success("Yearly subscription already exists: premium_yearly (ID: #{yearly.id})")
      else
        begin
          body = {
            data: {
              type: "subscriptions",
              attributes: {
                name: "Yearly Premium",
                productId: "premium_yearly",
                subscriptionPeriod: "ONE_YEAR",
                groupLevel: 1
              },
              relationships: {
                group: {
                  data: {
                    type: "subscriptionGroups",
                    id: group_id
                  }
                }
              }
            }
          }
          res = Spaceship::ConnectAPI.client.tunes_request_client.post("subscriptions", body)
          UI.success("Created Yearly Subscription: premium_yearly 🎉")
        rescue => e
          UI.error("Error creating Yearly Subscription: #{e.message}")
        end
      end
    end

    UI.success("All App Store Connect IAPs and Subscriptions configured successfully! 🚀")
  end

  desc "Create Subscription Group Localizations on App Store Connect"
  lane :setup_subscription_group_localizations do
    app = Spaceship::ConnectAPI::App.find("com.yarm.apps.dasverb")
    unless app
      UI.user_error!("Could not find app com.yarm.apps.dasverb on App Store Connect")
    end

    resp = Spaceship::ConnectAPI.client.tunes_request_client.get("subscriptionGroups", { "filter[app]" => app.id })
    groups_data = (resp.body && resp.body["data"]) || []
    if groups_data.empty?
      UI.user_error!("No subscription groups found for app #{app.name}")
    end

    localizations_map = {
      "en-US" => "dasVerb Premium",
      "ru" => "dasVerb Премиум",
      "de-DE" => "dasVerb Premium",
      "fr-FR" => "dasVerb Premium",
      "es-ES" => "dasVerb Premium",
      "es-MX" => "dasVerb Premium",
      "it" => "dasVerb Premium",
      "pt-BR" => "dasVerb Premium",
      "pt-PT" => "dasVerb Premium",
      "uk" => "dasVerb Преміум",
      "tr" => "dasVerb Premium",
      "pl" => "dasVerb Premium",
      "vi" => "dasVerb Premium",
      "nl-NL" => "dasVerb Premium",
      "ar-SA" => "dasVerb Premium",
      "zh-Hans" => "dasVerb Premium"
    }

    groups_data.each do |group_json|
      group_id = group_json["id"]
      group_name = group_json["attributes"]["referenceName"]
      UI.message("Processing Subscription Group: #{group_name} (ID: #{group_id})")

      # Fetch existing localizations
      existing_locs = []
      begin
        loc_resp = Spaceship::ConnectAPI.client.tunes_request_client.get("subscriptionGroups/#{group_id}/subscriptionGroupLocalizations")
        if loc_resp && loc_resp.body && loc_resp.body["data"]
          existing_locs = loc_resp.body["data"].map { |d| d["attributes"]["locale"] }
        end
      rescue => e
        UI.important("Could not fetch existing localizations: #{e.message}")
      end

      localizations_map.each do |locale, display_name|
        if existing_locs.include?(locale)
          UI.success("Localization '#{locale}' already exists for group #{group_name}")
          next
        end

        body = {
          data: {
            type: "subscriptionGroupLocalizations",
            attributes: {
              locale: locale,
              name: display_name
            },
            relationships: {
              subscriptionGroup: {
                data: {
                  type: "subscriptionGroups",
                  id: group_id
                }
              }
            }
          }
        }

        begin
          Spaceship::ConnectAPI.client.tunes_request_client.post("subscriptionGroupLocalizations", body)
          UI.success("Successfully created localization '#{locale}' ('#{display_name}') for group #{group_name} 🎉")
        rescue => e
          UI.error("Failed to create localization '#{locale}': #{e.message}")
        end
      end
    end

    UI.success("Finished configuring subscription group localizations! 🚀")
  end
end

platform :android do
  desc "Download Google Play Store metadata into fastlane/metadata/android"
  lane :download_metadata do
    json_key_file = ENV["PLAY_STORE_JSON_KEY"] || File.expand_path("../credentials/android/play-service-account.json", __dir__)
    sh("rm -rf ./fastlane/metadata/android && fastlane supply init --metadata_path ./fastlane/metadata/android --json_key '#{json_key_file}' --package_name com.yarm.apps.dasverb")
  end

  desc "Upload updated text metadata to Google Play"
  lane :sync_metadata do |options|
    archive_metadata_history("android")
    json_key_file = ENV["PLAY_STORE_JSON_KEY"] || File.expand_path("../credentials/android/play-service-account.json", __dir__)

    supply_args = {
      json_key: json_key_file,
      package_name: "com.yarm.apps.dasverb",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }

    if options[:version_code]
      supply_args[:version_code] = options[:version_code]
      supply_args[:skip_upload_changelogs] = false
    end

    supply(supply_args)
  end

  desc "Upload screenshots and images (icon, feature graphic, phone screenshots) to Google Play"
  lane :sync_screenshots do
    archive_metadata_history("android")
    json_key_file = ENV["PLAY_STORE_JSON_KEY"] || File.expand_path("../credentials/android/play-service-account.json", __dir__)

    supply(
      json_key: json_key_file,
      package_name: "com.yarm.apps.dasverb",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload all metadata, changelogs, icon, feature graphic and screenshots to Google Play"
  lane :sync_all do |options|
    archive_metadata_history("android")
    json_key_file = ENV["PLAY_STORE_JSON_KEY"] || File.expand_path("../credentials/android/play-service-account.json", __dir__)
    version_code = options[:version_code] || "1"

    supply(
      json_key: json_key_file,
      package_name: "com.yarm.apps.dasverb",
      metadata_path: "./fastlane/metadata/android",
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload production build.aab to Google Play Store"
  lane :release_production do |options|
    archive_metadata_history("android")
    aab_path = options[:aab] || "build.aab"
    json_key_file = ENV["PLAY_STORE_JSON_KEY"] || File.expand_path("../credentials/android/play-service-account.json", __dir__)

    supply(
      json_key: json_key_file,
      package_name: "com.yarm.apps.dasverb",
      metadata_path: "./fastlane/metadata/android",
      aab: aab_path,
      track: "production"
    )
  end
end
