{
  "name": "das-verb",
  "version": "1.0.1",
  "main": "expo/AppEntry.js",
  "scripts": {
    "clean-build:android": "expo prebuild --clean && yarn android",
    "clean-build:ios": "expo prebuild --clean && yarn ios",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:style": "stylelint \"src/**/*.styles.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "build:db": "tsx scripts/buildDatabase.ts",
    "validate:data": "tsx scripts/validateVerbsData.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "eas-build-post-install": "yarn build:db",
    "build:local:ios": "eas build --platform ios --profile production --local --output=./build.ipa",
    "build:local:android": "eas build --platform android --profile production --local --output=./build.aab",
    "bump-version": "node scripts/bump-version.js",
    "generate:screenshots": "node scripts/generate-appstore-screenshots.mjs",
    "generate:screenshots:ios": "node scripts/generate-appstore-screenshots.mjs --ios",
    "generate:screenshots:android": "node scripts/generate-appstore-screenshots.mjs --android",
    "============= PUBLISH SCRIPTS =============": "================================",
    "publish:app-config": "rclone copy ./assets/app-config.json der-artikel:das-verb-assets --s3-no-check-bucket --progress",
    "publish:app-ads": "rclone copy ./assets/app-ads.txt der-artikel:das-verb-assets --s3-no-check-bucket --progress",
    "publish:legal": "rclone copy ./assets/legal der-artikel:das-verb-assets/legal --s3-no-check-bucket --transfers=16 --progress",
    "publish:release:ios": "fastlane ios release_production",
    "publish:metadata:ios": "fastlane ios sync_metadata",
    "publish:screenshots:ios": "fastlane ios sync_screenshots",
    "publish:release:android": "fastlane android release_production",
    "publish:metadata:android": "fastlane android sync_metadata",
    "publish:screenshots:android": "fastlane android sync_screenshots",
    "============= DOWNLOAD SCRIPTS =============": "================================",
    "download:metadata:ios": "fastlane ios download_metadata",
    "download:screenshots:ios": "fastlane ios download_screenshots",
    "download:metadata:android": "fastlane android download_metadata"
  },
  "keywords": [
    "german",
    "verbs",
    "learning",
    "mobile",
    "react-native",
    "expo",
    "dasverb"
  ],
  "author": "",
  "license": "ISC",
  "description": "Mobile application to learn and practice German verbs (A1-B2)",
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^26.3.3",
    "@react-native-firebase/app": "^26.3.3",
    "@react-navigation/bottom-tabs": "7.15.5",
    "@react-navigation/native": "7.1.33",
    "@react-navigation/native-stack": "7.14.5",
    "compare-versions": "^6.1.1",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-audio": "1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-speech": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "react": "19.1.0",
    "react-intl": "^10.1.24",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "16.0.3",
    "react-native-mmkv": "2.12.2",
    "react-native-purchases": "9.11.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.6",
    "@babel/preset-env": "7.28.6",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@napi-rs/canvas": "^1.0.8",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1.10",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "babel-preset-expo": "54.0.10",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-unicorn": "55.0.0",
    "expo-dev-client": "~6.0.20",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "postcss-styled-components": "0.2.1",
    "postcss-syntax": "0.36.2",
    "prettier": "3.8.1",
    "puppeteer": "^25.10.0",
    "sharp": "0.34.5",
    "stylelint": "16.14.1",
    "stylelint-config-standard": "36.0.1",
    "stylelint-react-native": "2.7.0",
    "tsx": "4.23.12",
    "typescript": "5.9.2"
  }
}
