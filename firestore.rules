rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents (all-time scores, display name)
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // Cloud backup subcollection for progress synchronization
      match /backup/{docId} {
        allow read, write: if true;
      }
    }
    
    // Monthly leaderboard collections (leaderboard_YYYY_MM)
    match /{leaderboardCollection}/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscriptions collection mapping RevenueCat subscription ID to canonical user
    match /subscriptions/{subId} {
      allow read, write: if true;
    }

    // System counters collection for sequential user numbering
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
