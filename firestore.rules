rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents (all-time scores, display name)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Monthly leaderboard collections (leaderboard_YYYY_MM)
    match /{leaderboardCollection}/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
