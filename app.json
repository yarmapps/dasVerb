{
  "expo": {
    "name": "das Verb",
    "slug": "das-verb",
    "scheme": "dasverb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/base-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff6f4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yarm.apps.dasverb",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-adaptive-icon.png",
        "backgroundColor": "#fff6f4"
      },
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "package": "com.yarm.apps.dasverb",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withNonModularHeaders",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7651822935774581~1012442102",
          "iosAppId": "ca-app-pub-7651822935774581~9648163377"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "48bab158-a93b-43b0-b1b9-0e9e092635d1"
      }
    },
    "owner": "yarm.apps"
  }
}